{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Ping.aiff || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Glass.aiff || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/ashiharakun/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "*.npmjs.org",
        "pypi.org",
        "localhost",
        "127.0.0.1"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
        "/nix/var/nix/daemon-socket/socket"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/nix"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg"
      ]
    },
    "excludedCommands": [
      "docker"
    ]
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "ghostty",
  "agentPushNotifEnabled": true
}

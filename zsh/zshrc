autoload -Uz compinit
compinit

export PATH="/usr/local/sbin:$PATH"

eval "$(sheldon source)"
eval "$(starship init zsh)"
eval "$(direnv hook zsh)"
eval "$(zoxide init zsh)"

# 履歴関連
HISTFILE=$(eval echo ~$USER)/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000

setopt share_history
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt inc_append_history

setopt AUTO_CD
setopt AUTO_PARAM_KEYS


# エイリアス
alias mv='mv -i'
alias rm='rm -i'
alias cp='cp -i'

if [[ $(command -v eza) ]]; then
  alias ls='eza --icons --git'
  alias lt='eza -T -L 3 -a -I "node_modules|.git|.cache" --icons'
  alias ltl='eza -T -L 3 -a -I "node_modules|.git|.cache" -l --icons'
fi

alias ll='ls -lGF'
alias la="ls -la"

alias ..='cd ..'
alias ..2='cd ../..'
alias ..3='cd ../../..'

alias cdgt='cd $(git rev-parse --show-toplevel)'

alias -g G='| grep --color=auto'
alias -g C='| wc -l'

alias vi="nvim"

zshaddhistory() {
    local line="${1%%$'\n'}"
    [[ ! "$line" =~ "^(cd|jj?|lazygit|la|ll|ls|rm|rmdir)($| )" ]]
}

# zsh-abbr の略語を展開前でもハイライトする（起動時に読み込まれた略語のみ対象）
if (( ${#ABBR_REGULAR_USER_ABBREVIATIONS} )); then
  ZSH_HIGHLIGHT_HIGHLIGHTERS=(main regexp)
  ZSH_HIGHLIGHT_REGEXP=('^[[:blank:]]*('${(j:|:)${(Qk)ABBR_REGULAR_USER_ABBREVIATIONS}}')$' fg=blue)
fi

# yazi
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# ghq
function ghq-fzf_change_directory() {
  local src=$(ghq list | fzf --preview "eza -l -g -a --icons $(ghq root)/{}")
  if [ -n "$src" ]; then
    BUFFER="cd $(ghq root)/$src"
    zle accept-line
  fi
  zle -R -c
}

zle -N ghq-fzf_change_directory
bindkey '^f' ghq-fzf_change_directory
